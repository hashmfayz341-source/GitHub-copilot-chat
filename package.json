{
  "name": "anatomy-motion-lecture",
  "version": "1.0.0",
  "private": true,
  "description": "Introduction to Anatomy — motion-graphics lecture video built with Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "narrate": "python3 scripts/narrate.py",
    "render": "remotion render src/index.ts AnatomyLecture output/introduction-to-anatomy.mp4 --concurrency=4",
    "still": "remotion still src/index.ts AnatomyLecture output/still.png",
    "typecheck": "tsc --noEmit",
    "voice:providers": "node scripts/voice/produce.mjs --providers",
    "voice:status": "node scripts/voice/produce.mjs --status",
    "voice:produce": "node scripts/voice/produce.mjs",
    "timing:build": "node scripts/build-timing-ar.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@react-three/fiber": "^9.2.0",
    "@remotion/cli": "4.0.532",
    "@remotion/fonts": "^4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "@remotion/media-utils": "4.0.532",
    "@remotion/paths": "^4.0.532",
    "@remotion/three": "^4.0.532",
    "@remotion/transitions": "4.0.532",
    "@types/three": "^0.178.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.532",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "typescript": "5.8.3"
  }
}
